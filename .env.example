# Copy this file to .env and fill in your keys.  .env is gitignored — never commit real keys.

# --- Required ---------------------------------------------------------------

# Anthropic API (answer generation + batch summaries)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API (embeddings — text-embedding-3-small; RAGAS judge)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional ---------------------------------------------------------------

# openFDA key — raises the rate limit from 1K to 120K req/day
# https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# LangSmith tracing (agent pipeline observability)
# https://smith.langchain.com/
#   Tracing is OFF unless BOTH a flag and a key are set — a stray key alone must
#   never silently ship prompts to a SaaS. LANGSMITH_* are accepted as aliases.
#   Enable with: LANGCHAIN_TRACING_V2=true (or LANGSMITH_TRACING=true) + a key.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=MedDocAI

# Observability: per-query token/cost/latency rows in SQLite query_metrics.
# Set to 0 to disable the write (it is also skipped when the DB file is absent).
# MEDDOCAI_METRICS=1

# Qdrant connection
#   Leave QDRANT_URL unset for LOCAL embedded mode (dev default; uses QDRANT_PATH).
#   docker compose sets QDRANT_URL=http://qdrant:6333 automatically (server mode).
#   QDRANT_API_KEY is only needed for a secured / cloud Qdrant server.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_PATH=data/qdrant_storage
